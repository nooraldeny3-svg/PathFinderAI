PORT=4000
DATABASE_URL=postgres://pathfinder:pathfinder@localhost:5432/pathfinder
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173

# Max login/register attempts per IP within the window
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=900000

# Recommendation engine: openai | gemini | none (none = rule-based only)
AI_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
AI_TIMEOUT_MS=15000
AI_CACHE_TTL_MS=3600000
